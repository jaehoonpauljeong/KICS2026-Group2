<?xml version="1.0" encoding="UTF-8" ?>
<i2nsf-cfi-policy xmlns="urn:ietf:params:xml:ns:yang:ietf-i2nsf-cons-facing-interface" xmlns:i2nsfmi="urn:ietf:params:xml:ns:yang:ietf-i2nsf-monitoring-interface">
    <name>block_rdp_port_3389</name>
    <language>en-US</language>
    <priority-usage>priority-by-order</priority-usage>
    <resolution-strategy>fmr</resolution-strategy>

    <rules>
        <name>block_tcp_3389</name>
        <condition>
            <firewall>
                <transport-layer-protocol>i2nsfmi:tcp</transport-layer-protocol>
                <range-port-number>
                    <start>3389</start>
                    <end>3389</end>
                </range-port-number>
            </firewall>
        </condition>
        <action>
            <primary-action>
                <action>drop</action>
            </primary-action>
        </action>
    </rules>

    <rules>
        <name>block_udp_3389</name>
        <condition>
            <firewall>
                <transport-layer-protocol>i2nsfmi:udp</transport-layer-protocol>
                <range-port-number>
                    <start>3389</start>
                    <end>3389</end>
                </range-port-number>
            </firewall>
        </condition>
        <action>
            <primary-action>
                <action>drop</action>
            </primary-action>
        </action>
    </rules>
</i2nsf-cfi-policy>

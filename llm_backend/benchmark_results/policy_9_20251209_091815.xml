<?xml version="1.0" encoding="UTF-8"?>
<i2nsf-cfi-policy xmlns="urn:ietf:params:xml:ns:yang:ietf-i2nsf-cons-facing-interface" xmlns:i2nsfmi="urn:ietf:params:xml:ns:yang:ietf-i2nsf-monitoring-interface">
    <name>block_ftp_traffic_policy</name>
    <language>en-US</language>
    <priority-usage>priority-by-order</priority-usage>
    <resolution-strategy>fmr</resolution-strategy>

    <rules>
        <name>block_ftp_control_port_21</name>
        <condition>
            <firewall>
                <transport-layer-protocol>i2nsfmi:tcp</transport-layer-protocol>
                <range-port-number>
                    <start>21</start>
                    <end>21</end>
                </range-port-number>
            </firewall>
        </condition>
        <action>
            <primary-action>
                <action>drop</action>
            </primary-action>
        </action>
    </rules>

    <rules>
        <name>block_ftp_data_port_20</name>
        <condition>
            <firewall>
                <transport-layer-protocol>i2nsfmi:tcp</transport-layer-protocol>
                <range-port-number>
                    <start>20</start>
                    <end>20</end>
                </range-port-number>
            </firewall>
        </condition>
        <action>
            <primary-action>
                <action>drop</action>
            </primary-action>
        </action>
    </rules>
</i2nsf-cfi-policy>

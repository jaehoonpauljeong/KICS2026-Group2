<?xml version="1.0" encoding="UTF-8"?>
<i2nsf-cfi-policy
    xmlns="urn:ietf:params:xml:ns:yang:ietf-i2nsf-cons-facing-interface"
    xmlns:i2nsfmi="urn:ietf:params:xml:ns:yang:ietf-i2nsf-monitoring-interface">
  <name>block_smtp_port25_policy</name>
  <language>en-US</language>
  <priority-usage>priority-by-order</priority-usage>
  <resolution-strategy>fmr</resolution-strategy>

  <rules>
    <name>drop_smtp_tcp_25_any</name>
    <condition>
      <firewall>
        <transport-layer-protocol>i2nsfmi:tcp</transport-layer-protocol>
        <range-port-number>
          <start>25</start>
          <end>25</end>
        </range-port-number>
      </firewall>
      <context>
        <application>
          <protocol>i2nsfmi:smtp</protocol>
        </application>
      </context>
    </condition>
    <action>
      <primary-action>
        <action>drop</action>
      </primary-action>
    </action>
  </rules>
</i2nsf-cfi-policy>
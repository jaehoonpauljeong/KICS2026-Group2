<?xml version="1.0" encoding="UTF-8"?>
<i2nsf-cfi-policy xmlns="urn:ietf:params:xml:ns:yang:ietf-i2nsf-cons-facing-interface" xmlns:i2nsfcfi="urn:ietf:params:xml:ns:yang:ietf-i2nsf-cons-facing-interface">
  <name>allow_traffic_from_gb</name>
  <language>en-US</language>
  <priority-usage>i2nsfcfi:priority-by-order</priority-usage>
  <resolution-strategy>i2nsfcfi:fmr</resolution-strategy>

  <rules>
    <name>allow_from_gb</name>
    <condition>
      <context>
        <geographic-location>
          <source>
            <country>GB</country>
          </source>
        </geographic-location>
      </context>
    </condition>
    <action>
      <primary-action>
        <action>i2nsfcfi:pass</action>
      </primary-action>
    </action>
  </rules>
</i2nsf-cfi-policy>
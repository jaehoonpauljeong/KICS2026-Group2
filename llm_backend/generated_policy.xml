<?xml version="1.0" encoding="UTF-8"?>
<i2nsf-cfi-policy xmlns="urn:ietf:params:xml:ns:yang:ietf-i2nsf-cons-facing-interface" xmlns:i2nsfmi="urn:ietf:params:xml:ns:yang:ietf-i2nsf-monitoring-interface">
  <name>allow_ssh_rdp_remote_access_timebound</name>
  <language>en-US</language>
  <priority-usage>priority-by-order</priority-usage>
  <resolution-strategy>fmr</resolution-strategy>

  <!-- Allow window: 06:00:00–22:59:59 -->
  <rules>
    <name>allow_ssh_between_06_00_00_and_22_59_59</name>
    <condition>
      <firewall>
        <transport-layer-protocol>i2nsfmi:tcp</transport-layer-protocol>
        <range-port-number>
          <start>22</start>
          <end>22</end>
        </range-port-number>
      </firewall>
      <context>
        <time>
          <period>
            <start-time>06:00:00</start-time>
            <end-time>22:59:59</end-time>
            <day>monday</day>
            <day>tuesday</day>
            <day>wednesday</day>
            <day>thursday</day>
            <day>friday</day>
            <day>saturday</day>
            <day>sunday</day>
          </period>
        </time>
      </context>
    </condition>
    <action>
      <primary-action>
        <action>pass</action>
      </primary-action>
    </action>
  </rules>

  <rules>
    <name>allow_rdp_tcp_between_06_00_00_and_22_59_59</name>
    <condition>
      <firewall>
        <transport-layer-protocol>i2nsfmi:tcp</transport-layer-protocol>
        <range-port-number>
          <start>3389</start>
          <end>3389</end>
        </range-port-number>
      </firewall>

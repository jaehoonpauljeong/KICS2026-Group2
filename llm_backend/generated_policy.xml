            <day>thursday</day>
            <day>friday</day>
            <day>saturday</day>
            <day>sunday</day>
          </period>
        </time>
      </context>
    </condition>
    <action>
      <primary-action>
        <action>pass</action>
      </primary-action>
    </action>
  </rules>

  <rules>
    <name>allow_rdp_udp_between_06_00_00_and_22_59_59</name>
    <condition>
      <firewall>
        <transport-layer-protocol>i2nsfmi:udp</transport-layer-protocol>
